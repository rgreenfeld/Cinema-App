# ── Supabase credentials for scrapers/uploadToSupabase.js ─────────────
# Copy this file to the project root as ".env" and fill in your values.
# Get these from your Supabase project: Settings → API

# Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=

# Anon key (safe for client-side). For bulk writes prefer the service_role key.
SUPABASE_ANON_KEY=

# Optional: service_role key — bypasses Row Level Security.
# Only use server-side (never expose in a browser bundle).
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: table name (defaults to "screenings")
# SUPABASE_SCREENINGS_TABLE=screenings

